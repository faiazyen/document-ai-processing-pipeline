# Copy to .env and fill in values
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INPUT_USD_PER_1M_TOKENS=0
OPENAI_OUTPUT_USD_PER_1M_TOKENS=0
DATABASE_URL=sqlite:///./invoices.db
CORS_ALLOW_ORIGIN_REGEX=^https://.*\.vercel\.app$
PLATFORM_DEV_API_KEY=replace-with-a-local-dev-api-key
API_KEY_HASH_SECRET=replace-with-a-random-secret
DEFAULT_TENANT_ID=personal-lab
DEFAULT_TENANT_NAME=Personal Lab
DEFAULT_REGION=local
